{
  "name": "music-downloader",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently --kill-others -n api,web \"bun run --filter server dev\" \"bun run --filter web dev\"",
    "prod:frontend": "bun run --filter web build",
    "prod:backend": "bun run --filter server start",
    "build": "bun run prod:frontend",
    "build:netlify": "bun run prod:frontend",
    "start": "bun run prod:backend"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
